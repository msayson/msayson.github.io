{
  "name": "msayson.github.io",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-site": "node scripts/prepare-site.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run prepare-site && astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "npm run build && npm run test:artifacts && npm run test:e2e",
    "test:artifacts": "node --test tests/artifacts.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "astro": "^7.4.11",
    "gray-matter": "^4.0.3",
    "sass": "^1.108.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "pagefind": "^1.6.0"
  }
}
