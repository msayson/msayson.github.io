---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { BlogPost } from "../utils/blog";
import { excerptHtml, formatDate, postUrl } from "../utils/blog";

const featuredImages = import.meta.glob<ImageMetadata>("../assets/images/*", {
  eager: true,
  import: "default",
});

interface Props {
  posts: BlogPost[];
  page: number;
  totalPages: number;
}

const { posts, page, totalPages } = Astro.props;

function featuredImageFor(post: BlogPost): ImageMetadata | undefined {
  const imagePath = post.data.featuredImage?.replace(
    /^\/images\//,
    "../assets/images/",
  );
  const image = imagePath ? featuredImages[imagePath] : undefined;
  if (post.data.featuredImage && !image) {
    throw new Error(`Featured image not found for ${post.id}: ${post.data.featuredImage}`);
  }
  return image;
}
---

<div class="home">
  <h1 class="page-heading">Posts</h1>
  <p><a class="page-link" href="/blog/categories/">View Categories</a></p>

  <ul class="post-list">
    {
      posts.map((post) => {
        const featuredImage = featuredImageFor(post);
        return (
          <li>
            <span class="post-meta">{formatDate(post.data.date)}</span>
            <h2>
              <a href={postUrl(post)}>{post.data.title}</a>
            </h2>
            <div set:html={excerptHtml(post)} />
            {featuredImage && (
              <Image
                src={featuredImage}
                alt={post.data.featuredImageAlt ?? post.data.title}
                format="webp"
              />
            )}
          </li>
        );
      })
    }
  </ul>

  {
    totalPages > 1 && (
      <nav class="pagination" aria-label="Blog pages">
        {page > 1 ? (
          <a href={page === 2 ? "/blog/" : `/blog/page${page - 1}/`}>
            &laquo; Newer
          </a>
        ) : (
          <span>&laquo; Newer</span>
        )}
        {Array.from({ length: totalPages }, (_, index) => index + 1).map(
          (pageNumber) =>
            pageNumber === page ? (
              <em aria-current="page">{pageNumber}</em>
            ) : (
              <a href={pageNumber === 1 ? "/blog/" : `/blog/page${pageNumber}/`}>
                {pageNumber}
              </a>
            ),
        )}
        {page < totalPages ? (
          <a href={`/blog/page${page + 1}/`}>Older &raquo;</a>
        ) : (
          <span>Older &raquo;</span>
        )}
      </nav>
    )
  }

  <br />
  <div>
    <p class="rss-subscribe">
      subscribe <a href="/feed.xml">via RSS</a>
    </p>
  </div>
</div>
