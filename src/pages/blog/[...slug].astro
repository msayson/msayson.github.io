---
import { getCollection, render } from "astro:content";
import BlogListing from "../../components/BlogListing.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { descriptionFor, formatDate, postUrl, sortPosts } from "../../utils/blog";

export async function getStaticPaths() {
  const pageSize = 8;
  const posts = sortPosts(await getCollection("posts"));
  const totalPages = Math.ceil(posts.length / pageSize);
  const postPaths = posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
  const pagePaths = Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    return {
      params: { slug: `page${page}` },
      props: {
        page,
        posts: posts.slice((page - 1) * pageSize, page * pageSize),
        totalPages,
      },
    };
  });

  return [...postPaths, ...pagePaths];
}

const { post, page, posts, totalPages } = Astro.props;
const PostContent = post ? (await render(post)).Content : null;
---

{
  post ? (
    <BaseLayout
      title={post.data.title}
      description={descriptionFor(post)}
    >
      <article class="post" itemscope itemtype="http://schema.org/BlogPosting">
        <header class="post-header">
          <h1 class="post-title" itemprop="name headline">{post.data.title}</h1>
          <p class="post-meta">
            <time datetime={post.data.date.toISOString()} itemprop="datePublished">
              {formatDate(post.data.date)}
            </time>
            {post.data.author && (
              <> • <span itemprop="author" itemscope itemtype="http://schema.org/Person">
                <span itemprop="name">{post.data.author}</span>
              </span></>
            )}
          </p>
        </header>
        <div class="post-content" itemprop="articleBody">
          {PostContent && <PostContent />}
        </div>
      </article>
      <div class="horizontal-rule"></div>
      <div id="more-posts-link">
        <a class="page-heading" href="/blog/">View all posts</a>
      </div>
    </BaseLayout>
  ) : (
    <BaseLayout>
      <BlogListing posts={posts} page={page} totalPages={totalPages} />
    </BaseLayout>
  )
}
