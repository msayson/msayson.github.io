---
import GithubLink from "../components/GithubLink.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Mark Sayson", description = "Notes on privacy engineering and distributed system verification." } = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://www.marksayson.com").href;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="stylesheet" href="/css/main.css" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Mark Sayson"
      href="https://www.marksayson.com/feed.xml"
    />
    {
      import.meta.env.PROD && (
        <>
          <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-0X2FJYXEPK"
          ></script>
          <script is:inline>
            {`
              window.dataLayer = window.dataLayer || [];
              function gtag(){window.dataLayer.push(arguments);}
              gtag('js', new Date());
              gtag('config', 'G-0X2FJYXEPK');
              (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
              (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
              m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
              })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');
              ga('create', 'UA-80369609-1', 'auto');
              ga('send', 'pageview');
            `}
          </script>
        </>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="wrapper">
        <a class="site-title" href="https://www.marksayson.com">Mark Sayson</a>
        <nav class="site-nav">
          <a href="#" class="menu-icon" aria-label="Menu">
            <svg viewBox="0 0 18 15" aria-hidden="true">
              <path fill="#424242" d="M18,1.484c0,0.82-0.665,1.484-1.484,1.484H1.484C0.665,2.969,0,2.304,0,1.484l0,0C0,0.665,0.665,0,1.484,0 h15.031C17.335,0,18,0.665,18,1.484L18,1.484z" />
              <path fill="#424242" d="M18,7.516C18,8.335,17.335,9,16.516,9H1.484C0.665,9,0,8.335,0,7.516l0,0c0-0.82,0.665-1.484,1.484-1.484 h15.031C17.335,6.031,18,6.696,18,7.516L18,7.516z" />
              <path fill="#424242" d="M18,13.516C18,14.335,17.335,15,16.516,15H1.484C0.665,15,0,14.335,0,13.516l0,0 c0-0.82,0.665-1.484,1.484-1.484h15.031C17.335,12.031,18,12.696,18,13.516L18,13.516z" />
            </svg>
          </a>
          <div class="trigger">
            <a class="page-link" href="/blog/">Blog</a>
            <a class="page-link" href="/about/">About</a>
          </div>
        </nav>
      </div>
    </header>

    <main class="page-content">
      <div class="wrapper">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrapper">
        <h2 class="footer-heading">Mark Sayson</h2>
        <div class="footer-col-wrapper">
          <div class="footer-col footer-col-1">
            <dl class="contact-list">
              <dt>Email</dt>
              <dd><a href="mailto:masayson@gmail.com">masayson@gmail.com</a></dd>
              <dt>LinkedIn</dt>
              <dd><a href="https://www.linkedin.com/in/mark-sayson-87208748">Mark Sayson</a></dd>
              <dt>GitHub</dt>
              <dd><GithubLink username="msayson" /></dd>
            </dl>
          </div>
          <div class="footer-col footer-col-2">
            <p>Notes on privacy engineering and distributed system verification.</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
